# Generate secrets; keep the real file mode 0600 and outside git.
POSTGRES_PASSWORD=replace-me
FORGE_DB_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me-long
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-with-even-length-hex
INNGEST_DEV=0
FORGE_APP_VERSION=git-sha
FORGE_CONFIG=/app/configs/settings.yaml
FORGE_VENDOR_DIR=/app/vendor
FORGE_RUN_ID=forge-2026-08-24
FORGE_RUN_DURATION_HOURS=96
FORGE_STOP_AT=
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://your-gateway.example/v1
FORGE_LLM_MODEL=mimo-v2.5
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=forge@example.com
SMTP_TO=operator@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional research MCPs. Leave blank to omit the server and its tools entirely.
# TinyFish is for public web search/fetch snapshots only; never send customer or payment data.
TINYFISH_API_KEY=
TINYFISH_MCP_URL=http://tinyfish-mcp:3711/mcp
