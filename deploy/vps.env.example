# Generate secrets; keep the real file mode 0600 and outside git.
POSTGRES_PASSWORD=replace-me
FORGE_DB_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me-long
INNGEST_EVENT_KEY=replace-me
INNGEST_SIGNING_KEY=replace-with-even-length-hex
INNGEST_DEV=0
FORGE_APP_VERSION=git-sha
FORGE_CONFIG=/app/configs/settings.yaml
FORGE_VENDOR_DIR=/app/vendor
FORGE_DATA_DIR=/app/data
FORGE_FRONTEND_DIST=/app/frontend/dist
# Set these to the owner of the host data/ directory (`id -u`, `id -g`).
FORGE_HOST_UID=1000
FORGE_HOST_GID=1000
FORGE_RUN_ID=forge-2026-08-24
FORGE_RUN_DURATION_HOURS=48
FORGE_MAX_CYCLES=500
FORGE_MAX_STORAGE_BYTES=536870912000
FORGE_QUEUE_CAPACITY=100
FORGE_WORKER_REPLICAS=5
FORGE_CAMPAIGN_ENABLED=1
# The durable scheduler is invoked every 10 minutes. Use a multiple of 10 here.
FORGE_CAMPAIGN_INTERVAL_MINUTES=10
FORGE_CAMPAIGN_FAMILIES_PER_SLOT=3
FORGE_CAMPAIGN_BEHAVIORAL_PER_SLOT=1
FORGE_CAMPAIGN_FAMILIES=ai_bank_impersonation,deepfake_executive_bec,agent_prompt_injection_payment_hijack,ai_family_emergency,ai_investment_coaching,synthetic_kyc_account_factory
FORGE_OPERATOR_TOKEN=
FORGE_STOP_AT=
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://your-gateway.example/v1
FORGE_LLM_MODEL=mimo-v2.5
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=forge@example.com
SMTP_TO=operator@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional research MCPs. Leave blank to omit the server and its tools entirely.
# TinyFish is for public web search/fetch snapshots only; never send customer or payment data.
TINYFISH_API_KEY=
TINYFISH_MCP_URL=http://tinyfish-mcp:3711/mcp
